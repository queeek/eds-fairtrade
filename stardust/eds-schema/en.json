  },
  {
   "section": "TextImage--wrapper",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Areas of focus"
    },
    {
     "role": "body",
     "order": 1,
     "text": "We want to build a world where everyone benefits from quality products, and enjoys quality of life. But this cannot be done in silo. You cannot separate human rights from environmental rights, child protection from living incomes and gender equity from worker’s rights."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Key issues",
     "href": "https://www.fairtrade.net/en/why-fairtrade/why-we-do-it.html"
    }
   ],
   "imgCount": 1,
   "editableTexts": 1,
   "repeats": []
