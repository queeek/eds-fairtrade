   "section": "RichtextSection",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "\"Fairtrade has changed my life. Indeed, in a crisis situation, I have an inflow of money for my needs instead of going into debt. And Fairtrade has made me a woman leader.”"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Affoué Angèle Kouassi has farmed cocoa on her own land for 14 years. She participated in Fairtrade’s Women’s School of Leadership in 2021."
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": []
