    {
     "role": "heading",
     "order": 0,
     "text": "What is Fairtrade?"
    },
    {
     "role": "body",
     "order": 1,
     "text": "For more than three decades, Fairtrade has been making an impact on the way trade works."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Find out more",
     "href": "https://www.fairtrade.net/en/why-fairtrade/what-we-do/what-is-fairtrade.html"
    },
    {
     "role": "heading",
     "order": 3,
     "text": "Fairtrade International Annual Report 2025"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Learn about our collective progress alongside farmers, workers, businesses, and partners worldwide in advancing fairer trade."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "Read more",
     "href": "https://www.fairtrade.net/en/get-involved/library/2025-annual-report.html"
    },
    {
     "role": "heading",
     "order": 6,
     "text": "Catalyst for resilience"
    },
    {
     "role": "body",
     "order": 7,
     "text": "Fairtrade's Global Strategy for 2026-2028 is here. Accelerating action today that drives resilience for tomorrow."
    },
    {
     "role": "cta",
     "order": 8,
     "text": "Find out more",
     "href": "https://www.fairtrade.net/en/about/our-strategy.html"
    }
   ],
